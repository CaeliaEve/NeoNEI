{
  "name": "neonei-backend",
  "version": "1.0.0",
  "private": true,
  "description": "NeoNEI catalog API",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env.local -r ts-node/register src/server.ts",
    "check": "tsc --noEmit",
    "build": "tsc",
    "start": "node --env-file-if-exists=../.env.local dist/server.js",
    "test": "node -r ts-node/register --test test/*.test.cjs"
  },
  "license": "MIT",
  "dependencies": {
    "@neonei/catalog": "file:../catalog",
    "@elysium/contracts": "file:../vendor/elysium-contracts-0.10.0.tgz",
    "compression": "^1.8.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
