PORT=3002
HOST=0.0.0.0
# Optional external URL used in logs/output links
# PUBLIC_BASE_URL=http://localhost:3002

# Preferred portable NeoNEI logical roots. Use these for new deployments.
NEONEI_DATA_DIR=/app/data
NEONEI_RUNTIME_DIR=/app/data/runtime
NEONEI_CACHE_DIR=/app/data/cache
NEONEI_LOG_DIR=/app/data/logs
NEONEI_PUBLISH_DIR=/app/data/publish
NEONEI_CONTRACTS_DIR=/app/contracts
NESQL_EXPORT_ROOT=/app/nesql-export

# Derived NESQL++ export paths. Override only when your export layout is non-standard.
IMAGES_PATH=/app/nesql-export/image
NESQL_SPLIT_ITEMS_DIR=/app/nesql-export/items
NESQL_SPLIT_RECIPES_DIR=/app/nesql-export/recipes
NESQL_IMAGES_DIR=/app/nesql-export/image/item
NESQL_CANONICAL_DIR=/app/nesql-export/canonical

# Runtime files. Usually these can stay under NEONEI_DATA_DIR.
DB_FILE=/app/data/database.db
ACCELERATION_DB_FILE=/app/data/acceleration.db
REBUILD_PROGRESS_FILE=/app/data/rebuild-progress.json
RECIPE_SUMMARIES_FILE=/app/data/recipe_summaries.csv
LOG_TO_CONSOLE=1

# Compatibility aliases for older scripts/configs. Prefer NESQL_EXPORT_ROOT/NEONEI_* above.
DATA_DIR=/app/data
LOG_DIR=/app/data/logs
PUBLISH_OUTPUT_DIR=/app/data/publish
NESQL_REPOSITORY_PATH=/app/nesql-export

# Public website hardening profile.
# Set to 1 after dist-data/publish payloads are precompiled; mutable control stays under token-gated /ops and /api/admin.
NEONEI_PUBLIC_RUNTIME_ONLY=1
# Required for /ops and /api/admin control-plane endpoints.
# NEONEI_ADMIN_TOKEN=change-me
# Optional: refresh publish bundles at boot when the server owns writable publish storage.
NEONEI_PUBLISH_MATERIALIZE_ON_START=0
