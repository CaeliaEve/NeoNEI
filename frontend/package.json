{
    "name":  "neonei-frontend",
    "private":  true,
    "version":  "0.0.0",
    "type":  "module",
    "scripts":  {
                    "dev":  "vite",
                    "build":  "vite build",
                    "typecheck":  "vue-tsc -b",
                    "preview":  "vite preview",
                    "bench:search-v3":  "node ../scripts/bench-search-v3.mjs --gate",
                    "bench:recipe-v3":  "node ../scripts/bench-recipe-v3.mjs --gate",
                    "bench:browser-atlas-v3":  "node ../scripts/bench-browser-atlas-v3.mjs --gate",
                    "compile:raw-export":  "node ../scripts/compile-raw-export.mjs",
                    "test:raw-export":  "node ../scripts/compile-raw-export.mjs --self-test",
                    "bench:recipe-search":  "node scripts/bench-recipe-search.mjs",
                    "release:regression":  "node scripts/release-regression-checklist.mjs",
                    "gate:c":  "playwright test -c scripts/pw-gatec.config.ts",
                    "validate:runtime-v3":  "node ../scripts/validate-runtime-v3-regression.mjs --gate",
                    "validate:native-render":  "node ../scripts/validate-native-render-smoke.mjs --self-test --gate",
                    "bench:browser-v3":  "node ../scripts/bench-browser-v3.mjs --gate",
                    "bench:native-surface":  "node ../scripts/native-surface-baseline.mjs",
                    "validate:runtime-contracts":  "node ../scripts/validate-runtime-contracts.mjs --gate",
                    "validate:semantic-runtime":  "node ../scripts/validate-semantic-runtime.mjs --gate",
                    "audit:api-runtime":  "node ../scripts/audit-api-runtime.mjs",
                    "audit:paths":  "node ../scripts/audit-path-portability.mjs",
                    "gate:runtime":  "node ../scripts/gate-runtime-release.mjs",
                    "gate:runtime:quick":  "node ../scripts/gate-runtime-release.mjs --quick",
                    "audit:api-runtime:gate":  "node ../scripts/audit-api-runtime.mjs --gate --max-legacy-api-references=0 --max-fallback-references=0 --max-legacy-dynamic-routes=0",
                    "test:path-portability-urls":  "node --test scripts/path-portability-url-regression.test.mjs",
                    "test:export-paths":  "node ../scripts/audit-export-paths.mjs --self-test",
                    "test:runtime-diagnostics":  "node --test scripts/runtime-diagnostics-regression.test.mjs",
                    "test:runtime-type-boundary":  "node --test scripts/runtime-type-boundary-regression.test.mjs",
                    "test:runtime-release-gate":  "node --test ../scripts/runtime-release-gate-regression.test.mjs",
                    "test:runtime-contract-portability":  "node --test ../scripts/runtime-contract-portability-regression.test.mjs",
                    "test:deployment-profile":  "node ../scripts/deployment-profile-smoke.mjs",
                    "validate:browser-pages-v3":  "node ../scripts/validate-browser-pages-v3.mjs --gate",
                    "validate:known-runtime-items":  "node ../scripts/validate-known-runtime-items.mjs --gate",
                    "validate:recipe-fragmentation":  "node ../scripts/validate-recipe-fragmentation.mjs --gate",
                    "validate:recipe-handlers":  "node ../scripts/validate-recipe-handler-metadata.mjs --gate",
                    "test:browser-search-cache":  "node --test scripts/browser-search-cache-regression.test.mjs",
                    "test:rust-compiler-scaffold":  "node ../scripts/rust-compiler-gate.mjs",
                    "test:rust-compiler":  "node ../scripts/rust-compiler-gate.mjs --run-cargo",
                    "test:rust-retirement":  "node ../scripts/rust-retirement-gate.mjs --gate --quick",
                    "test:rust-retirement:full":  "node ../scripts/rust-retirement-gate.mjs --gate",
                    "test:wasm-engine":  "node ../scripts/wasm-engine-gate.mjs",
                    "test:native-runtime-packs":  "node ../scripts/validate-native-runtime-packs.mjs --gate",
                    "test:native-runtime-projection":  "node ../scripts/native-runtime-projection-gate.mjs --gate",
                    "test:runtime-service-worker":  "node --test scripts/runtime-service-worker-regression.test.mjs"
                },
    "dependencies":  {
                         "axios":  "^1.13.2",
                         "pinia":  "^3.0.4",
                         "pinyin-pro":  "^3.28.0",
                         "three":  "^0.179.1",
                         "vue":  "^3.5.24",
                         "vue-router":  "^4.6.4"
                     },
    "devDependencies":  {
                            "@playwright/test":  "^1.58.2",
                            "@tailwindcss/postcss":  "^4.1.18",
                            "@types/node":  "^24.10.1",
                            "@vitejs/plugin-vue":  "^6.0.1",
                            "@vue/tsconfig":  "^0.8.1",
                            "autoprefixer":  "^10.4.23",
                            "postcss":  "^8.5.6",
                            "tailwindcss":  "^3.4.19",
                            "typescript":  "~5.9.3",
                            "vite":  "^7.2.4",
                            "vue-tsc":  "^3.1.4"
                        }
}
