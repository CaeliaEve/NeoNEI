VITE_BACKEND_BASE_URL=http://localhost:3002
# Optional override. If omitted, defaults to ${VITE_BACKEND_BASE_URL}/api
# VITE_API_BASE_URL=http://localhost:3002/api
# Single source of truth for recipe browser switch (do not use query/localStorage)
# rollback: set to 0 and deploy together with backend/data/version-map.json rollback target
VITE_RECIPE_BROWSER_V2=1

# Production/public runtime hardening. Development may set these to 0 while rebuilding runtime packs.
VITE_PUBLIC_RUNTIME_ONLY=1
VITE_RUNTIME_DISABLE_DEV_COMPAT=1
VITE_STRICT_RUNTIME_CONTRACTS=1
