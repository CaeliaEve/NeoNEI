# NeoNEI portable local configuration example
# Copy to .env.local or backend/.env as needed. Do not commit machine-specific .env files.

# Windows local example:
# NESQL_EXPORT_ROOT=E:/GTNH/.minecraft/versions/GT New Horizons 2.8.4-java8/nesql/current-export
# NEONEI_DATA_DIR=E:/neonei/data

# Linux server example:
# NESQL_EXPORT_ROOT=/srv/neonei/exports/current
# NEONEI_DATA_DIR=/srv/neonei/data

# Docker example:
# NESQL_EXPORT_ROOT=/app/nesql-export
# NEONEI_DATA_DIR=/app/data

PORT=3002
FRONTEND_PORT=5173
NEONEI_BACKEND_MODE=start

# Public website profile: serve only /runtime, /publish, /dist-data, /contracts and static assets.
# Dev-only /lab and legacy dynamic /api data routes are disabled when this is 1.
# NEONEI_PUBLIC_RUNTIME_ONLY=1
