{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neonei.local/contracts/runtime/error.schema.json",
  "title": "NeoNEI Runtime Error",
  "type": "object",
  "required": ["error"],
  "additionalProperties": true,
  "properties": {
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": true,
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "details": { "type": "object" },
        "requestId": { "type": "string" },
        "runtime": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "sourceSignature": { "type": "string" },
            "schemaVersion": { "type": "string" }
          }
        }
      }
    }
  }
}
